{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noImplicitAny": true,
		"strictPropertyInitialization": false,
		"useDefineForClassFields": false,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": []
	},
	"include": ["src/**/*.ts", "tools/**/*.ts"]
}
